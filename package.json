{
  "name": "moilstack-md",
  "version": "1.1.3",
  "description": "Markdown editor with AI assistance by MoilStack",
  "main": "src/main/index.js",
  "scripts": {
    "start": "nodemon --exec electron . --watch src --ext js,html,css",
    "test": "jest",
    "make-app-icon": "node build/make-app-icon.js",
    "make-file-icon": "node build/make-file-icon.js",
    "package": "electron-builder --config electron-builder.config.js",
    "postinstall": "patch-package"
  },
  "keywords": [
    "markdown",
    "editor",
    "ai",
    "moilstack"
  ],
  "author": "MoilStack",
  "license": "MIT",
  "type": "commonjs",
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^24.13.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "nodemon": "^3.1.14",
    "patch-package": "^8.0.1",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5"
  },
  "dependencies": {
    "katex": "^0.17.0"
  }
}
